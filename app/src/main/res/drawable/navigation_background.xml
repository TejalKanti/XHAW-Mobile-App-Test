<?xml version="1.0" encoding="utf-8"?>

<!-- Background used for the drop-down navigation menu. -->

<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Semi-Dark gaming-style background -->
    <solid android:color="#8C8181" />

    <!-- Purple border -->
    <stroke
        android:width="2dp"
        android:color="#57008A" />

    <!-- Slightly rounded corners -->
    <corners android:radius="8dp" />

</shape>