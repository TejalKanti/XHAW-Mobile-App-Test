<?xml version="1.0" encoding="utf-8"?>

<!--
    SERVICE / PACKAGE DETAIL PAGE

    The selected service or package is displayed here.

    This keeps the Services and Packages pages clean
    while allowing every item to have its own detail view.
-->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header -->
    <include
        layout="@layout/header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="20dp">

            <!-- Item image -->
            <ImageView
                android:id="@+id/detailIcon"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:scaleType="centerInside"
                android:contentDescription="Selected gaming service or package" />

            <!-- Item name -->
            <TextView
                android:id="@+id/detailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAlignment="center"
                android:textColor="#000000"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Item price -->
            <TextView
                android:id="@+id/detailPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAlignment="center"
                android:textColor="#57008A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Description -->
            <TextView
                android:id="@+id/detailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="#333333"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />

            <!-- Separate fee calculation -->
            <Button
                android:id="@+id/detailCalculateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="CALCULATE FEES" />

        </LinearLayout>

    </ScrollView>

    <include
        layout="@layout/footer" />

</LinearLayout>