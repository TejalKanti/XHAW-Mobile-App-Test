<?xml version="1.0" encoding="utf-8"?>

<!--
    ARENA ITEM CARD

    This layout is used for:
    - Gaming packages
    - Individual gaming services

    The same card structure is reused on both pages.
-->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:id="@+id/itemCard"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_margin="8dp"

    android:orientation="horizontal"

    android:gravity="center_vertical"

    android:padding="14dp"

    android:background="@drawable/card_background"

    android:clickable="true"
    android:focusable="true">

    <!-- Service/package image -->

    <ImageView
        android:id="@+id/itemIcon"

        android:layout_width="80dp"
        android:layout_height="80dp"

        android:layout_marginEnd="16dp"

        android:scaleType="centerInside"

        android:contentDescription="Gaming service or package icon" />

    <!-- Text information -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_weight="1"

        android:orientation="vertical">

        <!-- Name -->

        <TextView
            android:id="@+id/itemName"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:textColor="#000000"

            android:textSize="17sp"

            android:textStyle="bold" />

        <!-- Price -->

        <TextView
            android:id="@+id/itemPrice"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:textColor="#57008A"

            android:textSize="15sp"

            android:textStyle="bold" />

        <!-- Click instruction -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:text="Tap to view details"

            android:textColor="#666666"

            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>